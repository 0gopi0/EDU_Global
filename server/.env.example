# ---------------------------------------------------------------
# Copy this file to `server/.env` and fill in your own values.
#   cp server/.env.example server/.env
# ---------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=4000

# --- MySQL (local server) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=edu_global

# --- Auth ---
# Must be at least 32 characters. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d
# Must be `false` for http://localhost, otherwise the browser discards the
# session cookie and signing in appears to do nothing. Set to `true` only when
# serving over HTTPS.
COOKIE_SECURE=false

# --- Seeded admin account (used by `npm run db:seed`) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@eduglobal.test
ADMIN_PASSWORD=change_this_to_a_strong_password

# --- Uploads ---
MAX_UPLOAD_MB=5
