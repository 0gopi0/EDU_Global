<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Never rewrite API calls or uploaded files to index.html
  RewriteCond %{REQUEST_URI} ^/(api|uploads)(/|$) [NC]
  RewriteRule ^ - [L]
  # React SPA routing
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
